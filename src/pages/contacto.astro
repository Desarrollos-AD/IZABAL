---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <header class="contacto">
    <div class="contenedor">
      <div class="contacto__contenedor">
        <h1 class="contacto__titulo">Contacto</h1>
        <h2 class="contacto__subtitulo">
          ¿Tienes alguna duda o comentario? ¡Nos encantaría saber de ti!
        </h2>
      </div>
      <div class="contacto__fondo"></div>
    </div>
  </header>
  <section>
    <div class="contenedor">
      <div class="formulario">
        <div class="formulario__formas">
          <div class="contenedor">
            <h3>Formas de contacto</h3>
            <p>
              Puedes contactarnos a través del siguiente formulario o visitarnos
              en nuestra ubicación.
            </p>
            <div class="formulario__formas--contacto">
              <div class="contacto__item">
                <div class="contacto__item--img">
                  <img src="/icons/llamada.png" alt="icono de teléfono" />
                </div>
                <div class="contacto__item--des">
                  <h4>Teléfono</h4>
                  <p>+52 123 456 7890</p>
                </div>
              </div>
              <div class="contacto__item">
                <div class="contacto__item--img">
                  <img
                    src="/icons/correo.png"
                    alt="icono de correo electrónico"
                  />
                </div>
                <div class="contacto__item--des">
                  <h4>Correo Electrónico</h4>
                  <p>izabalproyec@gmail.com</p>
                </div>
              </div>
              <div class="contacto__item">
                <div class="contacto__item--img">
                  <img src="/icons/ubicacion.png" alt="icono de dirección" />
                </div>
                <div class="contacto__item--des">
                  <h4>Dirección</h4>
                  <p>
                    Av. Palmeras #646 Fracc. Jardines de Virginia C.P. 94294
                    Boca del Río, Ver.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="formulario__correo">
          <div class="contenedor">
            <h3>Envíanos un mensaje</h3>
            <form action="">
              <div class="correo--item">
                <div class="form__grupo">
                  <label for="nombre">Nombre:</label>
                  <input
                    type="text"
                    id="nombre"
                    name="nombre"
                    required
                    placeholder="Ingresa tu nombre:"
                  />
                </div>
                <div class="form__grupo">
                  <label for="compania">Compañía:</label>
                  <input
                    type="text"
                    id="compania"
                    name="compania"
                    required
                    placeholder="Ingresa tu compañía:"
                  />
                </div>
              </div>
              <div class="correo--item">
                <div class="form__grupo">
                  <label for="correo">Correo Electrónico:</label>
                  <input
                    type="email"
                    id="correo"
                    name="correo"
                    required
                    placeholder="Ingresa tu correo electrónico:"
                  />
                </div>
                <div class="form__grupo">
                  <label for="telefono">Teléfono:</label>
                  <input
                    type="tel"
                    id="telefono"
                    name="telefono"
                    required
                    placeholder="Ingresa tu teléfono:"
                  />
                </div>
              </div>
              <div class="textarea">
                <label for="mensaje">Mensaje:</label>
                <textarea
                  id="mensaje"
                  name="mensaje"
                  rows="5"
                  required
                  placeholder="Ingresa tu mensaje aquí..."></textarea>
              </div>
              <button type="submit" class="btn btn_verde">Enviar Mensaje</button
              >
            </form>
          </div>
        </div>
      </div>
    </div>
    <div class="mapa">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7537.884014814297!2d-96.11286880653293!3d19.15401564259858!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85c3411e5a1f8131%3A0xb43b7b1606b2792f!2sAv%20de%20las%20Palmeras%20646%2C%20Jardines%20del%20Virginia%2C%2094294%20Veracruz%2C%20Ver.!5e0!3m2!1ses-419!2smx!4v1767111973569!5m2!1ses-419!2smx"
        width="600"
        height="450"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</Layout>
