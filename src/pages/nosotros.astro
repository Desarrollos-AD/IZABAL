---
import Layout from "../layouts/Layout.astro";
import Descripcion from "../components/descripcion.astro";
---

<Layout>
  <header class="header__nosotros">
    <div class="contenedor">
      <div class="header__contenedor">
        <h1 class="header__titulo">Sobre Nosotros</h1>
        <h2 class="header__subtitulo">
          Transmitimos profesionalismo, respaldo técnico y enfoque estratégico.
        </h2>
      </div>
      <div class="header__fondo"></div>
    </div>
  </header>

 <Descripcion/>
 
  <section class="separador">
    <div class="contenedor">
      <div class="separador__contenido">
        <div class="separador__contenido--info">
          <h2>Valores de Izabal</h2>
          <p>
            <span>Excelencia Profesional </span>Aplicamos conocimiento
            especializado, análisis riguroso y actualización constante para
            ofrecer soluciones de alto nivel.
          </p>
          <p>
            <span>Integridad:</span> Actuamos con honestidad, transparencia y apego
            a la legalidad en cada uno de nuestros servicios y decisiones.
          </p>
          <p>
            <span>Confianza y Confidencialidad:</span> Construimos relaciones sólidas
            y duraderas, protegiendo la información y los intereses de nuestros clientes.
          </p>
          <p>
            <span> Enfoque Estratégico: </span>Analizamos cada proyecto con
            visión integral, orientando nuestras acciones al crecimiento
            sostenible y a resultados medibles.
          </p>
          <p>
            <span> Compromiso con el Cliente: </span>Acompañamos de manera
            cercana y responsable cada etapa del proyecto, adaptándonos a las
            necesidades específicas de cada cliente.
          </p>
          <p>
            <span> Eficiencia Operativa: </span>Optimizamos recursos, tiempos y
            procesos para generar soluciones claras, oportunas y de alto valor
            agregado.
          </p>
        </div>
        <div class="separador__contenido--img">
          <img
            src="/img/valores_3.png"
            alt="Icono Valores"
            width="900"
            height="800"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>
  <!-- Sección Misión y Visión -->
  <section class="contenedor__valores">
    <div class="contenedor">
      <div class="valores">
        <div class="valores__mision">
          <div class="contenedor">
            <div class="valores__mision--info">
              <h2>Misión de Izabal</h2>
              <p>
                En Consultoría de Proyectos Izabal, nuestra misión es brindar
                soluciones integrales, estratégicas y especializadas en
                servicios financieros, contables, fiscales, legales,
                inmobiliarios y de asesoría empresarial. Acompañamos a nuestros
                clientes con un enfoque profesional, ético y personalizado,
                apoyándolos en la optimización de recursos, el cumplimiento
                normativo y la gestión eficiente de proyectos. Trabajamos con
                análisis experto y visión estratégica para impulsar el
                crecimiento sostenible, la rentabilidad y la toma de decisiones
                sólidas en cada organización que confía en nosotros.
              </p>
              <div class="valores__mision--img">
                <img
                  src="/img/valores_1.png"
                  alt="Icono valores"
                  loading="lazy"
                  width="900"
                  height="800"
                />
              </div>
            </div>
          </div>
        </div>
        <div class="valores__vision">
          <div class="contenedor">
            <div class="valores__vision--info">
              <h2>Visión de Izabal</h2>
              <p>
                Ser la firma líder en consultoría y servicios integrales en
                Veracruz, México, reconocida por su excelencia profesional,
                confiabilidad y compromiso con el éxito de nuestros clientes.
                Aspiramos a consolidarnos como el socio estratégico de empresas
                y particulares, apoyándolos en el logro de sus objetivos
                mediante soluciones innovadoras, eficientes y de alto valor
                agregado, alineadas con las mejores prácticas y estándares
                nacionales e internacionales en cada una de nuestras áreas de
                especialización.
              </p>
              <div class="valores__vision--img">
                <img
                  src="/img/valores_2.webp"
                  alt="Icono vision"
                  loading="lazy"
                  width="900"
                  height="800"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Descripcion>
