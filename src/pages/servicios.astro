---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section id="servicios" class="py-5">
    <div class="container">
      <h2 class="text-center mb-4">Nuestros Servicios</h2>
      <div class="row">
        <!-- Consultoría Legal -->
        <div class="col-md-4 mb-4">
          <div class="card h-100">
            <div class="card-body">
              <h5 class="card-title">Consultoría Financiera</h5>
              <p class="card-text">
                Asesoría Financiera para mejorar los resultados de tu
                organización.
              </p>
              <!-- Lista de enlaces con botones alineado izquierda-->
              <ul class="list-unstyled">
                <li>
                  <a href="servicios.html" class="btn btn-success d-block mb-2"
                    >Financieros
                  </a>
                </li>
                <li>
                  <a
                    href="consultoria-empresarial.html"
                    class="btn btn-success d-block mb-2">Empresarial</a
                  >
                </li>
                <li>
                  <a
                    href="consultoria-legal.html"
                    class="btn btn-success d-block mb-2">Legal</a
                  >
                </li>
                <li>
                  <a
                    href="consultoria-contable.html"
                    class="btn btn-success d-block mb-2">Contable</a
                  >
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Consultoría Empresarial (Alineado al centro con fondo morado) -->
        <div class="col-md-4 mb-4">
          <div class="card h-100">
            <div class="card-body seccion-central">
              <h5 class="card-title">Financieros</h5>
              <p class="list-services">
                <!-- Lista no ordenada para los servicios -->
                <ul class="list-unstyled">
                  <li>Servicio de asesoría en Análisis de inversión</li>
                  <li>
                    Servicio de asesoría y consultoría en acuerdos de
                    inversiones
                  </li>
                  <li>
                    Análisis de datos de mercado para una mejor negociación
                  </li>
                  <li>Asesoría en financiación de vivienda</li>
                </ul>
              </p>
            </div>
          </div>

          <!-- Consultoría Contable (Alineado derecha con fondo verde) -->
          <div class="col-md-4 mb-4">
            <div class="card h-100">
              <img
                src="assets/img/Mesa%20de%20trabajo%20182.png"
                class="card-img-top"
                alt="Consultoría Contable"
                style="height: 250px; object-fit: cover;"
              />
              <div class="card-body text-center seccion-derecha">
                <h5 class="card-title">Consultoría Contable</h5>
                <p class="card-text">Servicios en asesoria Financiera.</p>
                <a href="contacto.html" class="btn btn-success"
                  >Inicia una consulta personalizada</a
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sección Principal -->
    <header>
      <div class="container">
        <div class="row section-columns">
          <!-- Columna de texto -->
          <div class="text-column">
            <h1 class="display-4">Consultoría de Proyectos</h1>
            <p class="lead">Tu proyecto respaldado por los mejores.</p>

            <ul class="list-unstyled">
              <li>
                <a
                  href="mailto:izabalproyec@gmail.com?subject=Consulta%20de%20servicios&body=Hola,%20me%20gustaría%20obtener%20más%20información%20sobre%20sus%20servicios."
                  class="btn btn-success btn-animado"
                  ><i class="bi bi-envelope"></i> Genera resultados hoy</a
                >
              </li>
            </ul>
          </div>
          <!-- Columna de imagen -->
          <div class="image-column">
            <img
              src="assets/img/bloque1%20index.jpg"
              alt="Consultoría"
              class="img-fluid imagen-animada"
            />
          </div>
        </div>
      </div>
    </header>
  </section>
</Layout>
